#pragma once
// Don't copy this by hand: `octo device setup` writes secrets.h (gitignored) with the Wi-Fi details
// from firmware/bench/03_wifi/secrets.h and a fresh signing key it also keeps in data/device.json.
// Must be a 2.4 GHz network.
#define WIFI_SSID "your-network"
#define WIFI_PASS "your-password"
#define OCTO_KEY "your-key"  // 64 hex characters: the HMAC-SHA256 key shared with the Mac
